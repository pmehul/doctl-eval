# Python
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Secrets. .env holds the real Serverless Inference key and must never be committed.
.env
.env.local
.env.*
!.env.example

# macOS / editors
.DS_Store
.idea/
*.swp

# Build noise
build.log

# Run output. Throwaway runs are ignored, because a full run writes about a megabyte
# and most of them are scratch.
#
# Runs tagged "live" are committed, though. Persisted eval results are one of the
# requested deliverables, and this pattern had already swallowed the only one: the
# submission zip is built with `git archive`, which ships tracked files only, so the
# result would have been missing from the deliverable without anything reporting a
# problem. Nothing warns you that an ignored file was left out of an archive.
#
# Simulated runs stay ignored. They are output from the offline stub and cannot
# support a recommendation.
data/runs/*
!data/runs/.gitkeep
!data/runs/*-live-*.json
DigitalOcean FDE Evaluation Exercise.pdf

# My own interview notes. Deliberately not shipped: the submission zip is built
# with `git archive`, so anything tracked here goes to the reviewer, and a file
# containing a demo script and anticipated questions is not something to hand over.
mehul_interview.txt
mehul_presentation.txt
mehul_presentation.pptx
mehul_presentation_technical.pptx
# PowerPoint lock files, created while the deck is open
~$*
scripts/_build_deck.py
scripts/_build_exec_deck.py
scripts/_live_run.py
scripts/_fetch_run.py
