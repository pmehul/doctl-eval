# Copy to .env and fill in. Never commit the real thing.
#
#   cp .env.example .env
#   docker run --rm -p 8080:8080 --env-file .env doctl-eval

# ── Login ───────────────────────────────────────────────────────────────────
# Set a password whenever this app is reachable from anywhere but localhost.
# Leave it empty and every route is open, which is fine on a laptop and NOT fine
# on a public URL: POST /api/run spends real credits, about $0.27 a run, and
# there is no rate limit. A public unprotected URL could drain the balance.
# /api/health stays open either way so a platform health check can reach it.
BASIC_AUTH_USERNAME=reviewer
BASIC_AUTH_PASSWORD=

# ── Provider ────────────────────────────────────────────────────────────────
# digitalocean = real calls, spends credits.
# mock         = offline simulator. Runs the whole harness without a key. Its
#                numbers prove nothing and the UI says so.
PROVIDER=digitalocean

# DigitalOcean API key with inference access. Needed when PROVIDER=digitalocean.
DO_INFERENCE_API_KEY=

# Any OpenAI-compatible endpoint. Only change this to point somewhere else.
# Nothing here is DigitalOcean-specific.
DO_INFERENCE_BASE_URL=https://inference.do-ai.run/v1

# ── Concurrency and retries ─────────────────────────────────────────────────
# How many requests are in the air at once, shared between both models. Can also
# be set per run in the UI. Turning it up buys wall-clock time and pays for it in
# p95, since queue time shows up as latency, and in rate limits.
CONCURRENCY=16

REQUEST_TIMEOUT_S=120
MAX_RETRIES=3
RETRY_BASE_DELAY_S=1.0

# ── Generation ──────────────────────────────────────────────────────────────
# 0 so runs reproduce. Any randomness turns up as accuracy wobbling run to run.
TEMPERATURE=0
MAX_TOKENS=96
# Reasoning models write out their thinking before answering and need far more
# room. Set this too low and they run out mid-thought, which shows up as a
# parse_error.
REASONING_MAX_TOKENS=1400

# ── Scoring ─────────────────────────────────────────────────────────────────
# test = the locked half. Quote these numbers.
# dev  = where the prompt was tuned. Flattering, for iterating only.
SCORED_SPLIT=test

# 0 = sort all 536 issues. Above 0 takes an even spread, for a quick test.
MAX_ISSUES=0

PERSIST_RUNS=true
RUNS_DIR=./data/runs

# ── Simulator only ──────────────────────────────────────────────────────────
# Shrinks the fake wait so a demo takes about 10s instead of 2min. The
# concurrency limit still has to queue work, so throughput keeps the right shape,
# but the wall clock is squeezed by this much. Set to 1 for real timings.
MOCK_TIME_SCALE=10

PORT=8080
